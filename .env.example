# Credenciales de Futmondo
# Obtén estos valores haciendo POST /login con tu email y contraseña,
# o inspecciona las peticiones de red en la app (DevTools → Network → api.futmondo.com).

# Token de autenticación (obtenido via POST /login — se renueva en cada sesión)
FUTMONDO_TOKEN=tu_token_aqui

# ID MongoDB de tu usuario (campo "userid" en la respuesta de /login)
FUTMONDO_USER_ID=tu_user_id_aqui

# ID MongoDB del campeonato (obtenido via GET /championship)
# NOTA: el número que ves en la app ("1.624") son tus PUNTOS, no el ID del campeonato
FUTMONDO_CHAMPIONSHIP_ID=tu_championship_id_aqui

# ID MongoDB de tu equipo dentro del campeonato (obtenido via GET /championship)
FUTMONDO_USER_TEAM_ID=tu_user_team_id_aqui
