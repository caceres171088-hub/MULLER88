# Credenciales de Futmondo — cuenta: MULLER
# Obtén token y userid haciendo POST /login con tu email y contraseña,
# o inspecciona las peticiones de red en la app (DevTools → Network → api.futmondo.com).

# Token de autenticación de tu cuenta (obtenido via POST /login o DevTools)
FUTMONDO_TOKEN=tu_token_aqui

# ID numérico de tu usuario (campo "userid" en la respuesta de /login)
# Cuenta: MULLER
FUTMONDO_USER_ID=tu_user_id_aqui

# ID del campeonato — "ESTATODOPAGADO"
FUTMONDO_CHAMPIONSHIP_ID=1624

# ID numérico de tu equipo dentro del campeonato
# Equipo: PACHA IBIZA  (aparece en la respuesta de GET /championship)
FUTMONDO_USER_TEAM_ID=tu_user_team_id_aqui
