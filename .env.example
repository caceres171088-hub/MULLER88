# Credenciales de Futmondo
# Obtén estos valores desde la app de Futmondo (inspecciona las peticiones de red)

# Token de autenticación de tu cuenta
FUTMONDO_TOKEN=tu_token_aqui

# ID de tu usuario en Futmondo
FUTMONDO_USER_ID=tu_user_id_aqui

# ID del campeonato en el que participas
FUTMONDO_CHAMPIONSHIP_ID=tu_championship_id_aqui

# ID de tu equipo dentro del campeonato
FUTMONDO_USER_TEAM_ID=tu_user_team_id_aqui
